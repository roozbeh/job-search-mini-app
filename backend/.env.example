# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/jobsearch?retryWrites=true&w=majority
MONGODB_DB=jobsearch

PORT=8000

# ── Job Search ────────────────────────────────────────────────────────────────
# Provider: "serpapi" (active) | "agnic" (deprecated — requires paid credential)
JOB_SEARCH_PROVIDER=serpapi
SERPAPI_KEY=<get from serpapi.com — 250 free searches/month>
AGNIC_JOB_SEARCH_BASE=https://api.agnic.ai/v1/custom/job-search
AGNIC_FETCH_PROXY=https://api.agnic.ai/api/x402/fetch

# ── LLM: Resume Analysis ──────────────────────────────────────────────────────
# Deep reasoning — called ONCE per resume upload.
# Key resolution: user Agnic token → this key → AGNICPAY_API_KEY
# Agnic users:  their OAuth token used automatically (leave KEY empty).
# Apple users:  KEY required here.
RESUME_ANALYSIS_MODEL=openai/gpt-4o
RESUME_ANALYSIS_KEY=
RESUME_ANALYSIS_URL=https://api.agnic.ai/v1

# ── LLM: Title Expansion ─────────────────────────────────────────────────────
# Two creative models run in parallel — called ONCE per job search.
# Same key resolution as above.
TITLE_EXPANSION_MODEL_A=openai/gpt-5
TITLE_EXPANSION_MODEL_B=anthropic/claude-sonnet-4
TITLE_EXPANSION_KEY=
TITLE_EXPANSION_URL=https://api.agnic.ai/v1

# ── LLM: Match Score ─────────────────────────────────────────────────────────
# Cheap high-volume model — called PER JOB CARD.
# Same key resolution as above.
# Future swap: Gemini free tier (ai.google.dev, 1500 req/day free).
#   MATCH_SCORE_MODEL=gemini-2.0-flash
#   MATCH_SCORE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MATCH_SCORE_MODEL=openai/gpt-4o-mini
MATCH_SCORE_KEY=
MATCH_SCORE_URL=https://api.agnic.ai/v1

# ── Legacy fallback ───────────────────────────────────────────────────────────
# Last-resort if all role keys above are empty. Leave empty in production.
AGNICPAY_API_KEY=
